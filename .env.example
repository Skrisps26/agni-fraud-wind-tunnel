# AGNI configuration (all optional; the system runs fully offline without these)

# --- Deterministic core ---
AGNI_SEED=7

# --- Optional LLM enrichment (playbook text realism, judge scoring, critic proposals) ---
# Provider: openai | anthropic | none   (default: none -> deterministic templates)
AGNI_LLM_PROVIDER=none
AGNI_LLM_API_KEY=
AGNI_LLM_MODEL=

# --- Defense thresholds ---
AGNI_FPR_BUDGET=0.005        # max false-positive rate on legitimate traffic
AGNI_TTE_THRESHOLD=0.90      # AUC below which a frozen defender counts as evaded

# --- Loop sizing ---
AGNI_CONSUMERS=1200
AGNI_DAYS=10
AGNI_RUNS_PER_GENOME=4

# --- Real-data anchoring ---
AGNI_USD_INR=83.0            # fx used when fitting IEEE-CIS anchor to INR ticket sizes
